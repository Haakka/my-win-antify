{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyWinAntify",
  "version": "0.5.0",
  "identifier": "com.mywinantify.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyWinAntify",
        "width": 1120,
        "height": 740,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
